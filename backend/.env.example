# Copy to .env and fill in. Never commit the real .env.

# Django
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostGIS). In Docker Compose this points at the db service;
# the default below targets the host-mapped port for host-run manage.py.
DATABASE_URL=postgis://curbfeast:curbfeast@localhost:5438/curbfeast

# CORS: comma-separated origins allowed to call the API (Expo, web).
CORS_ALLOWED_ORIGINS=

# Geocoding (address -> coordinates), behind apps.core.geocoding. See ADR 0003.
# Defaults to free OSM Nominatim in dev; override for a prod provider.
# GEOCODING_PROVIDER=nominatim
# GEOCODING_USER_AGENT=Curbfeast/0.1 (+https://curbfeast.com)
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org/search
# GEOCODING_TIMEOUT=5
# GEOCODING_MAX_RETRIES=2
# GEOCODING_BACKOFF=0.5

# Map tiles for rendering (MapLibre). Not yet wired up.
# MAP_TILE_URL=
