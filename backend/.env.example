# Copy to .env and fill in. Never commit the real .env.

# Django
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostGIS). In Docker Compose this points at the db service;
# the default below targets the host-mapped port for host-run manage.py.
DATABASE_URL=postgis://curbfeast:curbfeast@localhost:5438/curbfeast

# CORS: comma-separated origins allowed to call the API (Expo, web).
CORS_ALLOWED_ORIGINS=

# Geo / maps (see docs/architecture/tech-stack.md). Not yet wired up.
# GEOCODING_PROVIDER=
# MAP_TILE_URL=
