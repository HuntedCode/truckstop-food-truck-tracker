# Copy to ".env" and set the API base URL the phone should hit.
#
# In Expo Go on a physical phone you CANNOT use localhost/127.0.0.1: that points
# at the phone itself. Use your computer's LAN IP (the same WiFi as the phone).
# Find it with `ipconfig` (Windows) -> "IPv4 Address", e.g. 192.168.1.23.
#
# The Django dev server already accepts any host (ALLOWED_HOSTS=["*"] in dev),
# and CORS does not apply to a native app, so only the IP needs to be right.
#
# EXPO_PUBLIC_ vars are inlined at build time and readable in the app via
# process.env (see src/lib/config.ts).
EXPO_PUBLIC_API_URL=http://192.168.1.23:8000/api/v1
